[include]
	path = ~/.gitconfig.local
[core]
	autocrlf = false
	excludesfile = ~/.gitignore_global
	hooksPath = ~/.git-hooks
[pull]
	rebase = false
[push]
	default = current
	autoSetupRemote = true
[fetch]
	prune = true
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
