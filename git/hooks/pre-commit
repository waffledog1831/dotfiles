#!/bin/bash
# main/master の最新が取り込まれているか確認する

MAIN=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
MAIN=${MAIN:-main}

# リモートの最新を取得（失敗しても続行）
git fetch origin "$MAIN" --quiet 2>/dev/null

BEHIND=$(git rev-list HEAD..origin/"$MAIN" --count 2>/dev/null)

if [ "${BEHIND:-0}" -gt 0 ]; then
  echo "ERROR: origin/$MAIN が $BEHIND コミット先行しています。"
  echo "       git pull してから作業してください。"
  exit 1
fi

# main/master への直接コミットを防ぐ（.mainonly が存在する場合は許可）
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$CURRENT_BRANCH" = "$MAIN" ] || [ "$CURRENT_BRANCH" = "master" ]; then
  REPO_ROOT=$(git rev-parse --show-toplevel)
  if [ ! -f "$REPO_ROOT/.mainonly" ]; then
    echo "ERROR: $CURRENT_BRANCH への直接コミットは禁止されています。"
    echo "       ブランチを切って作業してください: git checkout -b feature/your-branch"
    echo "       main で直接作業する場合は .mainonly ファイルを作成してください。"
    exit 1
  fi
fi
